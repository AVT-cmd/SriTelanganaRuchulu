# ==============================================================================
# Sri Telangana Ruchulu — Environment Variables Template
# Copy this file to `.env` (or configure in Vercel Dashboard -> Environment Variables).
# NEVER commit real passwords, API keys, or secrets to Git.
# ==============================================================================

# --- Server & Environment ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://sritelanganaruchulu.vercel.app

# --- Frontend (Vite Public Variables) ---
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=your_razorpay_public_key_id

# --- Authentication & Admin Security ---
OTP_SECRET=replace_with_a_strong_random_64_char_hmac_secret
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# --- SMTP Email Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email@example.com
SMTP_PASS=your_16_character_smtp_app_password
EMAIL_FROM="Sri Telangana Ruchulu" <your_smtp_email@example.com>

# --- Permanent Cloud Catalog & Order Persistence (Vercel Storage -> Upstash Redis / KV) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=


